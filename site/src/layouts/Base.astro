---
import Analytics from '@vercel/analytics/astro'
import '../styles/site.css'
import dmSans from '../assets/fonts/dm-sans-wght-subset.woff2?url'
import notoSans from '../assets/fonts/noto-sans-sc-subset.woff2?url'
import { copy, otherPath, type Lang } from '../i18n'
import { absolute, withBase } from '../site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
// Canonical, hreflang and link previews (X, Slack, iMessage) need absolute URLs.
const self = absolute(lang === 'en' ? '' : 'zh/', Astro.site)
const other = absolute(otherPath(lang), Astro.site)
const english = absolute('', Astro.site)
const ogImage = absolute('og-2.png', Astro.site)
const app = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Wavi',
  description: t.meta.description,
  url: self,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  image: ogImage
}).replace(/</g, '\\u003c') // keeps a `</script>` in copy from ending the tag
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#D8330E" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={self} />
    <link rel="alternate" hreflang={lang === 'en' ? 'en' : 'zh-CN'} href={self} />
    <link rel="alternate" hreflang={lang === 'en' ? 'zh-CN' : 'en'} href={other} />
    <link rel="alternate" hreflang="x-default" href={english} />
    <script type="application/ld+json" is:inline set:html={app} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('icon-64.png')} />
    <link rel="apple-touch-icon" href={withBase('icon-180.png')} />
    <link rel="preload" href={dmSans} as="font" type="font/woff2" crossorigin />
    {lang === 'zh' && <link rel="preload" href={notoSans} as="font" type="font/woff2" crossorigin />}
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
    <script>
      // A language link remembers the choice in the `lang` cookie: vercel.json sends "/" to "/zh/" for a Chinese-first
      // browser only while the cookie is missing, and always when it says zh.
      // auxclick: a middle click opens the link in a new tab without a click event.
      const remember = (event: MouseEvent): void => {
        const link = event.target instanceof Element ? event.target.closest('a[hreflang]') : null
        if (!link) return
        const lang = link.getAttribute('hreflang')?.startsWith('zh') ? 'zh' : 'en'
        document.cookie = `lang=${lang}; path=/; max-age=31536000; samesite=lax`
      }
      document.addEventListener('click', remember)
      document.addEventListener('auxclick', remember)
    </script>
  </body>
</html>
