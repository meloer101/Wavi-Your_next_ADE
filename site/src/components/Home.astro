---
/* The landing page (Figma frame O, 1794:15463) as ten screens: hero, the agent wall, two Agents screens, Board,
   GitHub, Windows, Appearance, FAQ, and the download block + footer. Every screen is one viewport when it can be
   (PRD v1.225). Static HTML and CSS; the only scripts are Ctas.astro's chip switch and the reveal script below. */
import type { Lang } from '../i18n'
import AgentGrid from './home/AgentGrid.astro'
import Agents from './home/Agents.astro'
import Appearance from './home/Appearance.astro'
import Board from './home/Board.astro'
import Faq from './home/Faq.astro'
import Footer from './home/Footer.astro'
import Github from './home/Github.astro'
import Hero from './home/Hero.astro'
import Nav from './home/Nav.astro'
import Strip from './home/Strip.astro'
import Windows from './home/Windows.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<div class="screen screen-hero">
  <Nav lang={lang} />
  <Hero lang={lang} />
</div>
<main id="main">
  <Strip lang={lang} />
  <Agents lang={lang} />
  <AgentGrid lang={lang} />
  <Board lang={lang} />
  <Github lang={lang} />
  <Windows lang={lang} />
  <Appearance lang={lang} />
  <Faq lang={lang} />
</main>
<Footer lang={lang} />

<script is:inline>
  // Reveals, the agent diagrams' loop control and the ⌘J keycap (PRD v1.225, v1.227 ②). Hidden states live under
  // html.js only, so the page shows everything without JavaScript; a browser without IntersectionObserver shows every
  // element at once. Inline and classic so the js class lands before the first paint (a deferred module would flash the
  // page first).
  ;(function () {
    var root = document.documentElement
    var all = document.querySelectorAll('[data-reveal]')
    var items = document.querySelectorAll('[data-reveal]:not([data-board-notice])')
    var hero = document.querySelectorAll('[data-hero], .hero-art')
    root.classList.add('js')
    function show(list) {
      for (var i = 0; i < list.length; i++) list[i].classList.add('in')
    }
    if (!('IntersectionObserver' in window)) {
      show(all)
      show(hero)
    } else {
      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue
            var target = entries[i].target
            target.classList.add('in')
            // The whole board reveals as one group, including cards outside the sideways-scrolled board; the
            // notification belongs to that group too.
            if (target.hasAttribute('data-board')) {
              var notice = target.parentElement.querySelector('[data-board-notice]')
              if (notice) notice.classList.add('in')
            }
            io.unobserve(target)
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
      )
      for (var j = 0; j < items.length; j++) io.observe(items[j])
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          show(hero)
        })
      })
    }
    // The six diagrams loop while they are on screen and hold where they are otherwise (PRD v1.227 ②); the class also
    // gets them going for the first time. The board runs its own loop, in Board.astro.
    var diagrams = document.querySelectorAll('[data-loop]')
    var loop = 'IntersectionObserver' in window && diagrams.length
      ? new IntersectionObserver(
          function (entries) {
            for (var n = 0; n < entries.length; n++) {
              entries[n].target.classList.toggle('in-view', entries[n].isIntersecting)
            }
          },
          { threshold: 0.2 }
        )
      : null
    for (var m = 0; m < diagrams.length; m++) {
      if (loop) loop.observe(diagrams[m])
      else diagrams[m].classList.add('in-view')
    }

    var jump = document.querySelector('[data-jump]')
    if (!jump) return
    var last = null
    jump.addEventListener('click', function () {
      // Look the cards up on every press: the board's loop moves them between columns, so the needs-you card changes.
      var cards = [].slice.call(document.querySelectorAll('.card-needs'))
      if (!cards.length) return
      var at = last ? cards.indexOf(last) : -1
      if (last) last.classList.remove('target')
      last = cards[(at + 1) % cards.length]
      last.classList.add('target')
      last.scrollIntoView({ block: 'nearest', inline: 'nearest' })
    })
  })()
</script>
