---
/* Screen 4: 01 Agents, part two — the intro as the lead, then the six diagrams, one per way of running several
   agents. Each diagram is inlined (AgentDiagram.astro) so it can loop through its own architecture while the screen is
   in the viewport (PRD v1.227 ②); the diagrams scale with the viewport height. */
import { copy, type Lang } from '../../i18n'
import AgentDiagram, { type DiagramKind } from './AgentDiagram.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = copy[lang]
const diagrams: DiagramKind[] = ['dispatch', 'leader', 'subagents', 'teams', 'workflows', 'same-task']
---

<section class="screen section-light">
  <div class="wrap">
    <p class="agents-lead" data-reveal>{t.agents.intro}</p>
    <div class="cells3">
      {t.agents.cells.map(([label, text], i) => (
        <div class="cell" data-reveal style={`--i:${i}`}>
          <AgentDiagram kind={diagrams[i]} />
          <h3 class="cell-title">{label}</h3>
          <p class="cell-text">{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
