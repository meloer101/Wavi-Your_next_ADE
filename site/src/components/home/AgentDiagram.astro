/* The six multi-agent diagrams of 01 Agents, inlined so each can show how its architecture works, looping while it is
   in the viewport (PRD v1.227 ②). Geometry, viewBox and colours are the Figma exports; the off-canvas background rects,
   the export's frame and its mask are dropped, the clip paths stay because the agent marks need them, and the parts
   that move carry class names instead of relying on document order. The static picture — no JavaScript, reduced motion
   — is the end state of every loop, the same picture the site showed before. */
export type DiagramKind = 'dispatch' | 'leader' | 'subagents' | 'teams' | 'workflows' | 'same-task'

interface Props {
  kind: DiagramKind
}
const { kind } = Astro.props
