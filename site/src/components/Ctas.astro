---
/* "Download for macOS" and "GitHub", each led by its own icon: the hero's buttons, repeated in the footer, plus the script
   that swaps in the Intel dmg. */
import { dmg, gh } from '../site'
import BtnIcon from './home/BtnIcon.astro'

interface Props {
  download: string
  github: string
  class?: string
}
const { download, github, class: extra } = Astro.props
---

<p class:list={['ctas', extra]}>
  <a class="btn btn-primary" href={dmg('arm64')} data-intel={dmg('x64')} rel="noopener"><BtnIcon name="download" />{download}</a>
  <a class="btn btn-ghost" href={gh()} rel="noopener"><BtnIcon name="github" />{github}</a>
</p>

<script>
  // Every download link starts the Apple silicon dmg. Chromium browsers report the chip through client hints, so an
  // Intel Mac there gets the x64 dmg instead; Safari and Firefox do not report it and keep the Apple silicon one.
  type Hints = { getHighEntropyValues(hints: string[]): Promise<{ architecture?: string }> }
  const hints = (navigator as Navigator & { userAgentData?: Hints }).userAgentData
  hints
    ?.getHighEntropyValues(['architecture'])
    .then(({ architecture }) => {
      if (architecture !== 'x86') return
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-intel]')) link.href = link.dataset.intel ?? link.href
    })
    .catch(() => undefined) // no answer: the Apple silicon link stays, which is the right one for most Macs
</script>
